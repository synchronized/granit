if(NOT DEFINED GRANIT_SOURCE_DIR)
  message(FATAL_ERROR "必须通过 GRANIT_SOURCE_DIR 指定仓库根目录")
endif()

set(action "${GRANIT_SOURCE_DIR}/.github/actions/setup-shader-toolchain/action.yml")
if(NOT EXISTS "${action}")
  message(FATAL_ERROR "缺少统一 Shader 工具链 Action")
endif()
file(READ "${action}" action_content)
foreach(required_text IN ITEMS "download_shader_toolchain.cmake" "root=$root")
  string(FIND "${action_content}" "${required_text}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Shader 工具链 Action 缺少契约：${required_text}")
  endif()
endforeach()

file(READ "${GRANIT_SOURCE_DIR}/.github/ci/compatibility-matrix.json" matrix)
file(READ "${GRANIT_SOURCE_DIR}/CMakePresets.json" presets)
string(JSON preset_count LENGTH "${presets}" testPresets)
math(EXPR last_preset "${preset_count}-1")
foreach(index RANGE 0 ${last_preset})
  string(JSON name GET "${presets}" testPresets ${index} name)
  if(name STREQUAL "test-default")
    string(JSON excluded GET "${presets}" testPresets ${index} filter exclude name)
    if(NOT excluded STREQUAL "_stress$")
      message(FATAL_ERROR "普通 test preset 必须默认排除长测")
    endif()
  endif()
endforeach()
set(identities)
foreach(suite IN ITEMS native sanitizers)
  string(JSON count LENGTH "${matrix}" ${suite})
  if(count LESS 1)
    message(FATAL_ERROR "兼容矩阵 ${suite} 不能为空")
  endif()
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    foreach(key IN ITEMS id os compiler version cc cxx expected linkage config sanitizer)
      string(JSON value GET "${matrix}" ${suite} ${index} ${key})
      if(value STREQUAL "")
        message(FATAL_ERROR "矩阵缺少 ${key}")
      endif()
    endforeach()
    string(JSON id GET "${matrix}" ${suite} ${index} id)
    if(id IN_LIST identities)
      message(FATAL_ERROR "矩阵 ID 重复：${id}")
    endif()
    list(APPEND identities "${id}")
  endforeach()
endforeach()

foreach(workflow IN ITEMS windows.yml linux.yml release.yml)
  file(READ "${GRANIT_SOURCE_DIR}/.github/workflows/${workflow}" content)
  string(FIND "${content}" "uses: ./.github/actions/setup-shader-toolchain" action_position)
  string(FIND "${content}" "steps.shader-toolchain.outputs.root" output_position)
  if(action_position EQUAL -1 OR output_position EQUAL -1)
    message(FATAL_ERROR "${workflow} 未统一消费 Shader 工具链 Action 输出")
  endif()
  if(content MATCHES "granit-shader-toolchain-v[0-9]")
    message(FATAL_ERROR "${workflow} 仍硬编码带版本的 Shader 工具链目录")
  endif()
endforeach()

foreach(workflow IN ITEMS windows.yml linux.yml emscripten.yml compatibility.yml)
  file(READ "${GRANIT_SOURCE_DIR}/.github/workflows/${workflow}" content)
  if(content MATCHES "\n  (pull_request|push|schedule|workflow_call):")
    message(FATAL_ERROR "${workflow} 完整验收只能手动触发")
  endif()
  string(FIND "${content}" "workflow_dispatch:" manual_position)
  if(manual_position EQUAL -1)
    message(FATAL_ERROR "${workflow} 必须保留手动完整验证入口")
  endif()
endforeach()
