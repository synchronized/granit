{
  "format_version": 4,
  "target_environment": "cross_backend",
  "binding_model": "bind_group",
  "material": {
    "constant_buffer_size": 32,
    "parameters": [
      {"name": "base_color", "type": "float4", "offset": 0},
      {"name": "alpha_cutoff", "type": "float32", "offset": 16}
    ]
  },
  "variants": [
    {
      "pass": "unlit_opaque",
      "pipeline": {
        "vertex_buffers": [{"stride": 12, "step_mode": "vertex", "attributes": [{"location": 0, "format": "float32x3", "offset": 0}]}],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "none", "polygon_mode": "fill"},
        "depth": {"test_enabled": true, "write_enabled": true, "compare": "less_equal"},
        "color_blend": {"enabled": false}
      },
      "shaders": [
        {"asset": "../../../assets/shaders/unlit/unlit.vert.grshader"},
        {"asset": "../../../assets/shaders/unlit/unlit.frag.grshader"}
      ]
    },
    {
      "pass": "unlit_alpha_cutoff",
      "features": [{"name": "unlit_alpha_cutoff", "value": 1}],
      "pipeline": {
        "vertex_buffers": [{"stride": 12, "step_mode": "vertex", "attributes": [{"location": 0, "format": "float32x3", "offset": 0}]}],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "none", "polygon_mode": "fill"},
        "depth": {"test_enabled": true, "write_enabled": true, "compare": "less_equal"},
        "color_blend": {"enabled": false}
      },
      "shaders": [
        {"asset": "../../../assets/shaders/unlit/unlit.vert.grshader"},
        {"asset": "../../../assets/shaders/unlit/unlit_alpha_cutoff.frag.grshader"}
      ]
    },
    {
      "pass": "unlit_transparent",
      "pipeline": {
        "vertex_buffers": [{"stride": 12, "step_mode": "vertex", "attributes": [{"location": 0, "format": "float32x3", "offset": 0}]}],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "none", "polygon_mode": "fill"},
        "depth": {"test_enabled": true, "write_enabled": false, "compare": "less_equal"},
        "color_blend": {
          "enabled": true,
          "source_color_factor": "one",
          "destination_color_factor": "one_minus_source_alpha",
          "source_alpha_factor": "one",
          "destination_alpha_factor": "one_minus_source_alpha"
        }
      },
      "shaders": [
        {"asset": "../../../assets/shaders/unlit/unlit.vert.grshader"},
        {"asset": "../../../assets/shaders/unlit/unlit.frag.grshader"}
      ]
    }
  ]
}
