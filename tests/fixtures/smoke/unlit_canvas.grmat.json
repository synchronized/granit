{
  "format_version": 4,
  "target_environment": "cross_backend",
  "binding_model": "bind_group",
  "material": {
    "constant_buffer_size": 32,
    "parameters": [
      {"name": "base_color", "type": "float4", "offset": 0},
      {"name": "alpha_cutoff", "type": "float32", "offset": 16},
      {"name": "base_color_texture", "type": "texture_view", "binding": 1},
      {"name": "unlit_sampler", "type": "sampler", "binding": 2}
    ]
  },
  "variants": [
    {
      "pass": "unlit_canvas",
      "features": [
        {"name": "unlit_textured", "value": 1},
        {"name": "unlit_vertex_color", "value": 1}
      ],
      "pipeline": {
        "vertex_buffers": [{"stride": 20, "step_mode": "vertex", "attributes": [
          {"location": 0, "format": "float32x2", "offset": 0},
          {"location": 1, "format": "float32x2", "offset": 8},
          {"location": 2, "format": "uint32", "offset": 16}
        ]}],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "none", "polygon_mode": "fill"},
        "depth": {"test_enabled": false, "write_enabled": false, "compare": "always"},
        "color_blend": {
          "enabled": true,
          "source_color_factor": "one",
          "destination_color_factor": "one_minus_source_alpha",
          "source_alpha_factor": "one",
          "destination_alpha_factor": "one_minus_source_alpha"
        }
      },
      "shaders": [
        {"asset": "../../../assets/shaders/unlit/unlit_canvas.vert.grshader"},
        {"asset": "../../../assets/shaders/unlit/unlit_canvas.frag.grshader"}
      ]
    },
    {
      "pass": "unlit_canvas_encode_srgb",
      "features": [
        {"name": "unlit_textured", "value": 1},
        {"name": "unlit_vertex_color", "value": 1},
        {"name": "unlit_encode_srgb", "value": 1}
      ],
      "pipeline": {
        "vertex_buffers": [{"stride": 20, "step_mode": "vertex", "attributes": [
          {"location": 0, "format": "float32x2", "offset": 0},
          {"location": 1, "format": "float32x2", "offset": 8},
          {"location": 2, "format": "uint32", "offset": 16}
        ]}],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "none", "polygon_mode": "fill"},
        "depth": {"test_enabled": false, "write_enabled": false, "compare": "always"},
        "color_blend": {
          "enabled": true,
          "source_color_factor": "one",
          "destination_color_factor": "one_minus_source_alpha",
          "source_alpha_factor": "one",
          "destination_alpha_factor": "one_minus_source_alpha"
        }
      },
      "shaders": [
        {"asset": "../../../assets/shaders/unlit/unlit_canvas.vert.grshader"},
        {"asset": "../../../assets/shaders/unlit/unlit_canvas_encode_srgb.frag.grshader"}
      ]
    }
  ]
}
