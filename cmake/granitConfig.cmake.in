@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/granitTargets.cmake")

if("Window" IN_LIST granit_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/granitWindowTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/granitWindowTargets.cmake")
    set(granit_Window_FOUND TRUE)
  else()
    set(granit_Window_FOUND FALSE)
  endif()
endif()
if("RenderPipeline" IN_LIST granit_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/granitRenderPipelineTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/granitRenderPipelineTargets.cmake")
    set(granit_RenderPipeline_FOUND TRUE)
  else()
    set(granit_RenderPipeline_FOUND FALSE)
  endif()
endif()
if("IntegrationSDL3" IN_LIST granit_FIND_COMPONENTS)
  include(CMakeFindDependencyMacro)
  find_dependency(SDL3 3.2 CONFIG)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/granitIntegrationSDL3Targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/granitIntegrationSDL3Targets.cmake")
    set(granit_IntegrationSDL3_FOUND TRUE)
  else()
    set(granit_IntegrationSDL3_FOUND FALSE)
  endif()
endif()
if("IntegrationImGui" IN_LIST granit_FIND_COMPONENTS)
  if(NOT TARGET imgui::imgui AND NOT TARGET ImGui::ImGui AND NOT TARGET imgui)
    find_package(imgui CONFIG QUIET)
  endif()
  if(NOT TARGET imgui::imgui AND NOT TARGET ImGui::ImGui AND NOT TARGET imgui)
    find_package(ImGui CONFIG QUIET)
  endif()
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/granitRenderPipelineTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/granitRenderPipelineTargets.cmake")
  endif()
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/granitIntegrationImGuiTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/granitIntegrationImGuiTargets.cmake")
    if(TARGET imgui::imgui OR TARGET ImGui::ImGui OR TARGET imgui)
      set(granit_IntegrationImGui_FOUND TRUE)
    else()
      set(granit_IntegrationImGui_FOUND FALSE)
    endif()
  else()
    set(granit_IntegrationImGui_FOUND FALSE)
  endif()
endif()
check_required_components(granit)
