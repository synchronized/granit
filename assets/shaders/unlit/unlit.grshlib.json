{
  "format_version": 1,
  "name": "unlit",
  "target_profile": "portable",
  "target_backends": ["vulkan", "webgpu"],
  "shaders": [
    {
      "name": "unlit.vertex",
      "source": "unlit.hlsl",
      "stage": "vertex",
      "entry_point": "vertex_main"
    },
    {
      "name": "unlit.fragment",
      "source": "unlit.hlsl",
      "stage": "fragment",
      "entry_point": "fragment_main",
      "variants": [
        {"name": "opaque", "defines": {"GRANIT_UNLIT_ALPHA_CUTOFF": "0"}},
        {"name": "alpha_cutoff", "defines": {"GRANIT_UNLIT_ALPHA_CUTOFF": "1"}}
      ]
    }
  ]
}
