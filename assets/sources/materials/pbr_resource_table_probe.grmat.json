{
  "format_version": 6,
  "target_environment": "cross_backend",
  "binding_model": "resource_table",
  "binding_groups": ["frame", "material", "object"],
  "implementations": [
    {
      "id": 2,
      "binding_model": "resource_table",
      "binding_groups": ["frame", "material", "object"]
    }
  ],
  "material": {
    "constant_buffer_size": 64,
    "parameters": [
      {"name": "base_color", "type": "float4", "offset": 0},
      {"name": "base_color_texture", "type": "texture_view", "binding": 1},
      {"name": "base_color_sampler", "type": "sampler", "binding": 6}
    ]
  },
  "variants": [
    {
      "pass": "opaque",
      "features": [{"name": "pbr_texture_mask", "value": 1}],
      "pipeline": {
        "vertex_buffers": [
          {
            "stride": 48,
            "step_mode": "vertex",
            "attributes": [
              {"location": 0, "format": "float32x3", "offset": 0},
              {"location": 1, "format": "float32x3", "offset": 12},
              {"location": 2, "format": "float32x4", "offset": 24},
              {"location": 3, "format": "float32x2", "offset": 40}
            ]
          }
        ],
        "primitive": {"topology": "triangle_list", "front_face": "clockwise", "cull_mode": "back", "polygon_mode": "fill"},
        "depth": {"test_enabled": true, "write_enabled": true, "compare": "less_equal"},
        "color_blend": {"enabled": false}
      },
      "shaders": [
        {"library": "pbr_resource_table", "shader": "standard.vertex", "implementation": 2},
        {"library": "pbr_resource_table", "shader": "standard.fragment", "implementation": 2}
      ]
    }
  ]
}
