{
  "format_version": 1,
  "name": "canvas",
  "target_profile": "portable",
  "target_backends": ["vulkan", "webgpu"],
  "shaders": [
    {
      "name": "canvas.vertex",
      "source": "unlit.hlsl",
      "stage": "vertex",
      "entry_point": "canvas_vertex_main",
      "variants": [
        {
          "name": "textured_vertex_color",
          "defines": {"GRANIT_UNLIT_TEXTURED": "1", "GRANIT_UNLIT_VERTEX_COLOR": "1"}
        }
      ]
    },
    {
      "name": "canvas.fragment",
      "source": "unlit.hlsl",
      "stage": "fragment",
      "entry_point": "fragment_main",
      "variants": [
        {
          "name": "textured_vertex_color",
          "defines": {"GRANIT_UNLIT_TEXTURED": "1", "GRANIT_UNLIT_VERTEX_COLOR": "1"}
        },
        {
          "name": "textured_vertex_color_encode_srgb",
          "defines": {
            "GRANIT_UNLIT_ENCODE_SRGB": "1",
            "GRANIT_UNLIT_TEXTURED": "1",
            "GRANIT_UNLIT_VERTEX_COLOR": "1"
          }
        }
      ]
    }
  ]
}
