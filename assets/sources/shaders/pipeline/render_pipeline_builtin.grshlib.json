{
  "format_version": 1,
  "name": "render_pipeline_builtin",
  "target_profile": "portable",
  "target_backends": ["vulkan", "webgpu"],
  "shaders": [
    {
      "name": "tone_mapping.vertex",
      "source": "tone_mapping.hlsl",
      "stage": "vertex",
      "entry_point": "vertex_main"
    },
    {
      "name": "tone_mapping.fragment",
      "source": "tone_mapping.hlsl",
      "stage": "fragment",
      "entry_point": "fragment_main"
    },
    {
      "name": "shadow_depth.vertex",
      "source": "shadow_depth.hlsl",
      "stage": "vertex",
      "entry_point": "vertex_main"
    },
    {
      "name": "shadow_depth.fragment",
      "source": "shadow_depth.hlsl",
      "stage": "fragment",
      "entry_point": "fragment_main"
    },
    {
      "name": "shadow_depth_mask.vertex",
      "source": "shadow_depth.hlsl",
      "stage": "vertex",
      "entry_point": "mask_vertex_main",
      "variants": [
        {"name": "uv0", "defines": {"GRANIT_PBR_HAS_UV1": "0"}},
        {"name": "uv1", "defines": {"GRANIT_PBR_HAS_UV1": "1"}}
      ]
    },
    {
      "name": "shadow_depth_mask.fragment",
      "source": "shadow_depth.hlsl",
      "stage": "fragment",
      "entry_point": "mask_fragment_main"
    }
  ]
}
