# 所有平台入口共享配置、构建、归档和退出语义；失败后仍保留部分报告。
cmake_minimum_required(VERSION 3.23)
if(DEFINED GRANIT_EXIT_CODE_FILE)
  file(WRITE "${GRANIT_EXIT_CODE_FILE}" "1\n")
endif()
foreach(required IN ITEMS GRANIT_SOURCE_DIR GRANIT_PRESET)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "缺少 ${required}")
  endif()
endforeach()
if(NOT DEFINED GRANIT_SUITE)
  set(GRANIT_SUITE default)
endif()
if(NOT GRANIT_SUITE MATCHES "^(default|quick|stress)$")
  message(FATAL_ERROR "未知验证范围：${GRANIT_SUITE}")
endif()
string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef nonce)
set(report "${GRANIT_SOURCE_DIR}/build/validation/${stamp}-${nonce}")
file(MAKE_DIRECTORY "${report}/logs")
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${GRANIT_SOURCE_DIR}"
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${GRANIT_SOURCE_DIR}"
                OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
set(environment "{}")
foreach(key IN ITEMS commit dirty GRANIT_PRESET GRANIT_SUITE CMAKE_HOST_SYSTEM_NAME
                     CMAKE_HOST_SYSTEM_VERSION CMAKE_HOST_SYSTEM_PROCESSOR)
  set(value "${${key}}")
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(JSON environment SET "${environment}" "${key}" "\"${value}\"")
endforeach()
file(WRITE "${report}/environment.json" "${environment}\n")
if(CMAKE_HOST_WIN32)
  execute_process(COMMAND powershell -NoProfile -Command
    "Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion | ConvertTo-Json"
    OUTPUT_FILE "${report}/gpu-driver.json" ERROR_FILE "${report}/logs/gpu-query.log")
else()
  execute_process(COMMAND vulkaninfo --summary OUTPUT_FILE "${report}/gpu-driver.txt"
    ERROR_FILE "${report}/logs/gpu-query.log" TIMEOUT 20)
endif()
foreach(key IN ITEMS VK_IMPLICIT_LAYER_PATH VK_LAYER_PATH VK_ICD_FILENAMES
                     GRANIT_VULKAN_RUNTIME GRANIT_VULKAN_LOADER_PATH
                     GRANIT_VULKAN_VALIDATION GRANIT_VULKAN_VALIDATION_PATH)
  file(APPEND "${report}/logs/runtime-environment.txt" "${key}=$ENV{${key}}\n")
endforeach()
message(STATUS "验证报告：${report}")
set(configure "${CMAKE_COMMAND}" --preset "${GRANIT_PRESET}")
if(GRANIT_SUITE STREQUAL "stress")
  list(APPEND configure -DGRANIT_ENABLE_STRESS_TESTS=ON)
  foreach(key IN ITEMS GRANIT_STRESS_SECONDS GRANIT_STRESS_SEED GRANIT_STRESS_ITERATIONS)
    if(DEFINED ${key})
      list(APPEND configure "-D${key}=${${key}}")
    endif()
  endforeach()
else()
  list(APPEND configure -DGRANIT_ENABLE_STRESS_TESTS=OFF)
endif()
set(build "${CMAKE_COMMAND}" --build --preset "${GRANIT_PRESET}")
set(test "${CMAKE_CTEST_COMMAND}" --preset "${GRANIT_PRESET}" --output-on-failure
         --no-tests=error --output-junit "${report}/junit.xml"
         --test-output-size-passed 1048576 --test-output-size-failed 1048576)
if(GRANIT_SUITE STREQUAL "quick")
  list(APPEND test -L "^(unit|smoke)$" -LE "^(gpu|platform|stress)$")
elseif(GRANIT_SUITE STREQUAL "stress")
  # 普通 test preset 默认排除长测；只有显式范围才覆盖该保护。
  list(APPEND test -L "^stress$" -LE "^$")
else()
  list(APPEND test -LE "^stress$")
endif()
set(status passed)
set(failed_stage "")
foreach(stage IN ITEMS configure build test)
  file(WRITE "${report}/logs/${stage}-command.txt" "${${stage}}\n")
  execute_process(COMMAND ${${stage}} WORKING_DIRECTORY "${GRANIT_SOURCE_DIR}"
    RESULT_VARIABLE result OUTPUT_FILE "${report}/logs/${stage}.log"
    ERROR_FILE "${report}/logs/${stage}.log")
  if(NOT result STREQUAL "0")
    set(status failed)
    set(failed_stage "${stage}")
    break()
  endif()
  if(stage STREQUAL "configure")
    # CTest 展开的测试清单包含真实构建目录，允许用户定制 preset binaryDir。
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --preset "${GRANIT_PRESET}"
      --show-only=json-v1 WORKING_DIRECTORY "${GRANIT_SOURCE_DIR}"
      OUTPUT_VARIABLE inventory RESULT_VARIABLE inventory_result)
    file(WRITE "${report}/logs/inventory.json" "${inventory}")
    if(inventory_result EQUAL 0)
      string(JSON test_count LENGTH "${inventory}" tests)
      if(test_count GREATER 0)
        string(JSON test_directory GET "${inventory}" tests 0 properties)
        string(JSON property_count LENGTH "${test_directory}")
        math(EXPR last_property "${property_count}-1")
        foreach(index RANGE 0 ${last_property})
          string(JSON property_name GET "${test_directory}" ${index} name)
          if(property_name STREQUAL "WORKING_DIRECTORY")
            string(JSON directory GET "${test_directory}" ${index} value)
            # 测试工作目录通常为子目录，向上查找配置时生成的环境身份。
            while(NOT EXISTS "${directory}/validation-environment.json")
              get_filename_component(parent "${directory}" DIRECTORY)
              if(parent STREQUAL directory)
                break()
              endif()
              set(directory "${parent}")
            endwhile()
            if(EXISTS "${directory}/validation-environment.json")
              file(COPY "${directory}/validation-environment.json" DESTINATION "${report}")
              file(COPY "${directory}/CMakeCache.txt" DESTINATION "${report}/logs")
            endif()
          endif()
        endforeach()
      endif()
    endif()
  endif()
endforeach()
if(DEFINED directory AND EXISTS "${directory}/Testing/Temporary/LastTest.log")
  file(COPY "${directory}/Testing/Temporary/LastTest.log" DESTINATION "${report}/logs")
endif()
set(executed_count 0)
set(skipped_count 0)
if(EXISTS "${report}/junit.xml")
  file(READ "${report}/junit.xml" junit)
  string(REGEX MATCHALL "<testcase[ >]" cases "${junit}")
  list(LENGTH cases executed_count)
  string(REGEX MATCHALL "<skipped[ />]" skipped "${junit}")
  list(LENGTH skipped skipped_count)
  if(junit MATCHES "tests=\"0\"")
    set(status failed)
    set(failed_stage test)
    set(result 1)
  elseif(junit MATCHES "disabled=\"[1-9][0-9]*\"" OR
         junit MATCHES "<skipped")
    # 跳过是证据缺口，不能汇总成全量通过；保留成功退出让调用者审查明细。
    if(status STREQUAL "passed")
      set(status incomplete)
    endif()
  endif()
endif()
file(WRITE "${report}/summary.json"
  "{\"status\":\"${status}\",\"failed_stage\":\"${failed_stage}\","
  "\"exit_code\":\"${result}\",\"test_count\":${executed_count},"
  "\"skipped_count\":${skipped_count}}\n")
if(DEFINED GRANIT_EXIT_CODE_FILE)
  # CMake 脚本本身只返回通用失败码；薄入口通过文件恢复子命令的数值退出码。
  if(result MATCHES "^[0-9]+$")
    file(WRITE "${GRANIT_EXIT_CODE_FILE}" "${result}\n")
  endif()
endif()
if(status STREQUAL "failed")
  file(READ "${report}/logs/${failed_stage}.log" failure)
  message("${failure}")
  message(FATAL_ERROR "${failed_stage} 失败（${result}），报告：${report}")
endif()
message(STATUS "验证完成：${report}")
